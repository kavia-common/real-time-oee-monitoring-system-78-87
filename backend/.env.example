# Backend configuration (development)

# Server
PORT=5000
NODE_ENV=development
TRUST_PROXY=false
LOG_LEVEL=info

# MongoDB (matches docker-compose.yml defaults)
MONGODB_URI=mongodb://root:example@localhost:27017/oee?authSource=admin

# Auth
JWT_SECRET=change-me-in-dev
JWT_EXPIRES_IN=12h

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# OEE
OEE_ALERT_THRESHOLD=0.75
