# Server
PORT=5000
NODE_ENV=development
TRUST_PROXY=false
LOG_LEVEL=info

# MongoDB
MONGODB_URI=mongodb://localhost:27017/oee_monitor

# Auth
JWT_SECRET=change_me_in_real_env
JWT_EXPIRES_IN=12h

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Alerts / thresholds
OEE_ALERT_THRESHOLD=0.75
